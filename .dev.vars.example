# Copy to .dev.vars for local development (never commit .dev.vars)
DEV_MODE=1
SESSION_SECRET=local-dev-secret-change-me
ADMIN_EMAILS=you@example.com
# GOOGLE_CLIENT_ID=...     # leave unset locally: DEV_MODE shows a type-any-email sign-in page instead
# GOOGLE_CLIENT_SECRET=...
# RESEND_API_KEY=re_...     # leave unset locally: reminder emails are logged instead
