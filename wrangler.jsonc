{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solarhisaab",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The web app (HTML, JS, CSS) is served as static assets.
  // Requests to /api/* and /auth/* run the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Accounts, meters and parsed bill data
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solarhisaab",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // The original bill PDFs
  "r2_buckets": [
    { "binding": "BILLS", "bucket_name": "solarhisaab-bills" }
  ],

  // Daily check for "your new bill is out" reminder emails (06:00 UTC = 11:00 PKT)
  "triggers": { "crons": ["0 6 * * *"] },

  "vars": {
    "APP_URL": "https://solarhisaab.pk",
    "APP_NAME": "SolarHisaab",
    "EMAIL_FROM": "SolarHisaab <hello@solarhisaab.pk>",
    "ADMIN_EMAILS": "you@example.com",
    "DEV_MODE": "0"
  },

  "observability": { "enabled": true }

  // After adding your domain to Cloudflare, uncomment to serve the app on it:
  // ,"routes": [
  //   { "pattern": "solarhisaab.pk", "custom_domain": true },
  //   { "pattern": "www.solarhisaab.pk", "custom_domain": true }
  // ]

  // Secrets (set with `npx wrangler secret put NAME`, never commit them):
  //   RESEND_API_KEY   API key from resend.com for sign-in and reminder emails
  //   SESSION_SECRET   any long random string, signs unsubscribe links
}
